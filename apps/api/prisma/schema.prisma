generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum PromotionStore {
  AMAZON
  MERCADO_LIVRE
  SHOPEE
}

enum PromotionStatus {
  APPROVED
  DRAFT
  FAILED
  PROCESSING
  PUBLISHED
  PUBLISHING
  READY_FOR_REVIEW
  REJECTED
}

enum PromotionWorkflowAction {
  APPROVE
  PUBLISH
  REJECT
  SUBMIT_FOR_REVIEW
}

enum PromotionIngestionSource {
  TELEGRAM
  WEB
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(ADMIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Promotion {
  id                   String                   @id @default(cuid())
  sourceUrl            String
  affiliateUrl         String
  store                PromotionStore
  status               PromotionStatus          @default(DRAFT)
  ingestionSource      PromotionIngestionSource
  sourceReference      String?                  @unique
  title                String
  message              String
  originalPriceInCents Int?
  priceInCents         Int
  couponCode           String?
  productImageUrl      String?
  generatedImageUrl    String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  events               PromotionEvent[]

  @@index([createdAt])
  @@index([status])
  @@index([store])
  @@map("promotions")
}

model PromotionEvent {
  id          String                  @id @default(cuid())
  promotionId String
  action      PromotionWorkflowAction
  actor       Role                    @default(ADMIN)
  fromStatus  PromotionStatus
  toStatus    PromotionStatus
  reason      String?
  createdAt   DateTime                @default(now())
  promotion   Promotion               @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, createdAt])
  @@map("promotion_events")
}
