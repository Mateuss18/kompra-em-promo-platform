{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src/app src/config src/modules src/plugins src/server.ts tests prisma.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:upsert": "tsx src/modules/users/upsertAdmin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fastify": "^5.11.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxlint": "~1.74.0",
    "prettier": "3.9.5",
    "prisma": "^7.9.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
